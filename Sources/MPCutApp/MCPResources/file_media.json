[
  {
    "name": "project_file_media_list",
    "description": "List current project media references, their statuses and uses. Poll file_job_status_read with the returned job_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_path": {
          "type": "string",
          "description": "Absolute path to a saved project.",
          "pattern": "^/"
        },
        "operation_id": {
          "type": "string",
          "description": "Fresh UUID for a distinct file job. Reuse it to retry an identical request.",
          "format": "uuid"
        },
        "working_directory": {
          "type": "string",
          "description": "Existing working directory for the CLI job.",
          "pattern": "^/"
        },
        "include_history": {
          "type": "boolean",
          "description": "Include media used only by retained undo or redo states. Defaults to false."
        }
      },
      "required": [
        "project_path",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "project_file_media_locate",
    "description": "Search a folder for relink candidates and optionally apply unique matches. Poll file_job_status_read with the returned job_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_path": {
          "type": "string",
          "description": "Absolute path to a saved project.",
          "pattern": "^/"
        },
        "operation_id": {
          "type": "string",
          "description": "Fresh UUID for a distinct file job. Reuse it to retry an identical request.",
          "format": "uuid"
        },
        "working_directory": {
          "type": "string",
          "description": "Existing working directory for the CLI job.",
          "pattern": "^/"
        },
        "folder": {
          "type": "string",
          "description": "Absolute path to the folder to search, including its subdirectories.",
          "pattern": "^/"
        },
        "include_history": {
          "type": "boolean",
          "description": "Include media used only by retained undo or redo states. Defaults to false."
        },
        "apply_matches": {
          "type": "boolean",
          "description": "Apply unique verified or matched candidates. Defaults to false."
        },
        "out_project": {
          "type": "string",
          "description": "Write a new project at this path.",
          "pattern": "^/"
        },
        "in_place": {
          "type": "boolean",
          "description": "Update the input project."
        }
      },
      "required": [
        "project_path",
        "operation_id",
        "folder"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "apply_matches"
            ],
            "properties": {
              "apply_matches": {
                "const": true
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "out_project"
                ]
              },
              {
                "required": [
                  "in_place"
                ],
                "properties": {
                  "in_place": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "apply_matches"
              ],
              "properties": {
                "apply_matches": {
                  "const": true
                }
              }
            }
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "out_project"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "in_place"
                  ],
                  "properties": {
                    "in_place": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "project_file_media_relink",
    "description": "Relink one or more paths to the same media, including references in retained undo and redo history. Poll file_job_status_read with the returned job_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_path": {
          "type": "string",
          "description": "Absolute path to a saved project.",
          "pattern": "^/"
        },
        "operation_id": {
          "type": "string",
          "description": "Fresh UUID for a distinct file job. Reuse it to retry an identical request.",
          "format": "uuid"
        },
        "working_directory": {
          "type": "string",
          "description": "Existing working directory for the CLI job.",
          "pattern": "^/"
        },
        "from": {
          "type": "string",
          "description": "Path returned by the project media list, or an absolute source path.",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "description": "Absolute path to the candidate media file.",
          "pattern": "^/"
        },
        "mappings": {
          "type": "array",
          "description": "Explicit old-to-new path mappings.",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "description": "Path returned by the project media list, or an absolute source path.",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "description": "Absolute path to the candidate media file.",
                "pattern": "^/"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "from_prefix": {
          "type": "string",
          "description": "Previous folder root.",
          "pattern": "^/"
        },
        "to_prefix": {
          "type": "string",
          "description": "New folder root.",
          "pattern": "^/"
        },
        "out_project": {
          "type": "string",
          "description": "Write a new project at this path.",
          "pattern": "^/"
        },
        "in_place": {
          "type": "boolean",
          "description": "Update the input project."
        }
      },
      "required": [
        "project_path",
        "operation_id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "from",
            "to"
          ],
          "not": {
            "required": [
              "mappings"
            ]
          },
          "allOf": [
            {
              "not": {
                "required": [
                  "from_prefix"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "to_prefix"
                ]
              }
            }
          ]
        },
        {
          "required": [
            "mappings"
          ],
          "allOf": [
            {
              "not": {
                "required": [
                  "from"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "to"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "from_prefix"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "to_prefix"
                ]
              }
            }
          ]
        },
        {
          "required": [
            "from_prefix",
            "to_prefix"
          ],
          "allOf": [
            {
              "not": {
                "required": [
                  "from"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "to"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "mappings"
                ]
              }
            }
          ]
        }
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "out_project"
              ]
            },
            {
              "required": [
                "in_place"
              ],
              "properties": {
                "in_place": {
                  "const": true
                }
              }
            }
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "project_file_media_replace",
    "description": "Preview the consequences of replacing a source. Set confirm to true and specify an output to apply the replacement. Poll file_job_status_read with the returned job_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_path": {
          "type": "string",
          "description": "Absolute path to a saved project.",
          "pattern": "^/"
        },
        "operation_id": {
          "type": "string",
          "description": "Fresh UUID for a distinct file job. Reuse it to retry an identical request.",
          "format": "uuid"
        },
        "working_directory": {
          "type": "string",
          "description": "Existing working directory for the CLI job.",
          "pattern": "^/"
        },
        "source": {
          "type": "string",
          "description": "Path returned by the project media list, or an absolute source path.",
          "minLength": 1
        },
        "with": {
          "type": "string",
          "description": "Absolute path to the candidate media file.",
          "pattern": "^/"
        },
        "conform": {
          "type": "string",
          "description": "Trim overlapping ranges to the new end, or keep affected ranges offline. Defaults to trim.",
          "enum": [
            "trim",
            "keep"
          ]
        },
        "allow_loss": {
          "type": "boolean",
          "description": "Approve the selected handling of ranges beyond the new end."
        },
        "confirm": {
          "type": "boolean",
          "description": "Apply the replacement. Omit or set false to preview."
        },
        "out_project": {
          "type": "string",
          "description": "Write a new project at this path.",
          "pattern": "^/"
        },
        "in_place": {
          "type": "boolean",
          "description": "Update the input project."
        },
        "use_id": {
          "type": "string",
          "minLength": 1,
          "description": "Apply to one use ID from project_editor_media_list. Omit to replace all uses."
        },
        "loss": {
          "type": "string",
          "enum": [
            "remove",
            "keep_offline"
          ],
          "description": "Explicit treatment of uses starting beyond the new source extent."
        },
        "clock": {
          "type": "string",
          "enum": [
            "source_relative",
            "source_timecode"
          ],
          "description": "Preserve relative times or map cuts through comparable source clocks."
        },
        "stream_mapping": {
          "type": "array",
          "maxItems": 256,
          "description": "Map selected old audio streams to candidate audio streams.",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "reset_crop": {
          "type": "boolean",
          "description": "Reset authored still crop to fit the new image."
        },
        "replacement_offset": {
          "type": "string",
          "minLength": 1,
          "description": "Exact multicam source offset in seconds or as a rational."
        },
        "shared_time_of_day": {
          "type": "boolean",
          "description": "Confirm that comparable mixed clock kinds share a time of day."
        },
        "transcript": {
          "type": "string",
          "enum": [
            "keep_unverified",
            "retranscribe"
          ],
          "description": "Keep the transcript unverified or remove the affected binding for retranscription."
        },
        "resync": {
          "type": "string",
          "enum": [
            "timecode",
            "waveform"
          ],
          "description": "Recompute multicam alignment using the selected method."
        }
      },
      "required": [
        "project_path",
        "operation_id",
        "source",
        "with"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "confirm"
            ],
            "properties": {
              "confirm": {
                "const": true
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "out_project"
                ]
              },
              {
                "required": [
                  "in_place"
                ],
                "properties": {
                  "in_place": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "confirm"
              ],
              "properties": {
                "confirm": {
                  "const": true
                }
              }
            }
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "out_project"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "in_place"
                  ],
                  "properties": {
                    "in_place": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    }
  },
