        },
        "operation_id": {
          "type": "string",
          "description": "Fresh UUID for a distinct file job. Reuse it to retry an identical request.",
          "format": "uuid"
        },
        "working_directory": {
          "type": "string",
          "description": "Existing working directory for the CLI job.",
          "pattern": "^/"
        },
        "source": {
          "type": "string",
          "description": "Path returned by the project media list, or an absolute source path.",
          "minLength": 1
        },
        "out_project": {
          "type": "string",
          "description": "Write a new project at this path.",
          "pattern": "^/"
        },
        "in_place": {
          "type": "boolean",
          "description": "Update the input project."
        }
      },
      "required": [
        "project_path",
        "operation_id",
        "source"
      ],
      "additionalProperties": false,
