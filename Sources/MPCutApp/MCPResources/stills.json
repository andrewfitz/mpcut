[
  {
    "name": "still_editor_placements_list",
    "description": "Read a page of image placements, including authored and visible ranges and asset availability.",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "project_handle"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "still_editor_soundtrack_attach",
    "description": "Attach a recording at program zero in a still-only sequence. Optionally fit its single image to the selected audio range.",
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "soundtrack": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute path to the recording."
        },
        "audio_stream": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional absolute audio stream index. Defaults to the first audio stream."
        },
        "from": {
          "type": "string",
          "description": "Optional source in-point on an audio sample boundary, as exact rational seconds."
        },
        "to": {
          "type": "string",
          "description": "Optional source out-point on an audio sample boundary, as exact rational seconds."
        },
        "fit_soundtrack": {
          "type": "boolean",
          "const": true,
          "description": "Fit the single image to the recording’s exact audible duration in the same edit."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "soundtrack"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "still_editor_soundtrack_fit",
    "description": "Fit the single image in a still-only sequence to its attached soundtrack’s exact audible duration.",
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "still_editor_soundtrack_detach",
    "description": "Detach the recording from a still-only sequence and keep its picture timing.",
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "timeline_clips_space",
    "description": "Set the gaps between consecutive picture items in one native undo step. Use a uniform duration or restore spacing from the source time between clips. Existing leading and trailing gaps are retained.",
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "string",
          "description": "Nonnegative uniform gap duration in exact rational seconds. Zero removes gaps between picture items."
        },
        "source_timing": {
          "type": "boolean",
          "const": true,
          "description": "Use source timing between chronologically ordered, nonoverlapping ranges of the same media file or multicam group. Use a uniform duration when spacing photo stills."
        },
        "cadence": {
          "type": "string",
          "description": "Positive frame interval in exact rational seconds, for example 1001/30000. Defaults to the timeline cadence when available. Omit it when removing gaps with duration zero."
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Gap color. Defaults to black."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "duration"
          ]
        },
        {
          "required": [
            "source_timing"
          ]
        }
      ]
    }
  },
  {
    "name": "still_editor_placement_insert",
    "description": "Insert the source image at the requested time, extending the timeline. Supply initial_format to start a still-only timeline in a blank sequence window.",
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute local image path."
        },
        "space": {
          "type": "string",
          "enum": [
            "sequence",
            "assembly"
          ]
        },
        "at": {
          "type": "string",
          "description": "Placement position in the selected clock. Exact rational seconds."
        },
        "duration": {
          "type": "string",
          "description": "Positive duration. Exact rational seconds."
        },
        "cadence": {
          "type": "string",
          "description": "Positive frame interval, for example 1001/30000. Exact rational seconds."
        },
        "fit": {
          "type": "string",
          "enum": [
            "fit",
            "fill"
          ]
        },
        "crop": {
          "type": "object",
          "description": "Normalized crop rectangle as exact rational coordinates.",
          "properties": {
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            },
            "width": {
              "type": "string"
            },
            "height": {
              "type": "string"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "initial_format": {
          "type": "object",
          "description": "Required for the first still or gap in a blank sequence, with at set to zero.",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8192
            },
            "cadence": {
              "type": "string",
              "description": "Exact frame interval in seconds, for example 1001/30000."
            },
            "codec": {
              "type": "string",
              "enum": [
                "h264",
                "hevc",
                "prores",
                "jpeg"
              ]
            },
            "container": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "enum": [
                "sdr",
                "pq",
                "hlg"
              ],
              "description": "Program color. Defaults to SDR."
            }
          },
          "required": [
            "width",
            "height",
            "cadence",
            "codec",
            "container"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "space",
        "at",
        "duration",
        "path"
      ],
      "additionalProperties": false
    }
  },
