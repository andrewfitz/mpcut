          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "placement"
      ],
      "additionalProperties": false
    }
  },
