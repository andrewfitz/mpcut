        "action": {
          "type": "string",
          "enum": [
            "select",
            "select_range",
            "mark_in",
            "mark_out",
            "clear_marks",
            "range_tool",
            "snap"
          ]
        },
        "occurrence": {
          "type": "string",
          "description": "Clip occurrence UUID from project_editor_state_read."
        },
        "from": {
          "type": "string",
          "description": "Sequence start time in seconds."
        },
        "to": {
          "type": "string",
          "description": "Sequence end time in seconds."
        },
        "space": {
          "type": "string",
          "enum": [
            "sequence",
            "source",
            "group",
            "assembly"
          ]
        },
        "time": {
          "type": "string",
          "description": "Exact media time as rational seconds, e.g. 1001/30000."
        },
        "enabled": {
          "type": "boolean",
          "description": "Requested setting."
        },
        "value": {
          "type": "string",
          "description": "Snap target off, keyframes, scenes, or silence, or a copy container extension supported by this sequence."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "occurrence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "select_range"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "mark_in"
              }
            }
          },
          "then": {
            "required": [
              "space",
              "time"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "mark_out"
              }
            }
          },
          "then": {
            "required": [
              "space",
              "time"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "range_tool"
              }
            }
          },
          "then": {
            "required": [
              "enabled"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "snap"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "playback_transport_control",
    "description": "Step to a boundary, shuttle, change preview speed or scrub in the specified clock.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Opaque live document handle from project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Document revision observed by the caller."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique mutation ID. Reuse only for an identical retry."
        },
        "action": {
          "type": "string",
          "enum": [
            "step",
            "shuttle",
            "speed",
            "scrub",
            "end_scrub"
          ]
        },
        "space": {
          "type": "string",
          "enum": [
            "sequence",
            "source",
            "group",
            "assembly"
          ]
        },
        "time": {
          "type": "string",
          "description": "Exact media time as rational seconds, e.g. 1001/30000."
        },
        "direction": {
          "type": "integer",
          "enum": [
            -1,
            1
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "frame",
            "keyframe",
            "scene",
            "pause"
          ]
        },
        "rate": {
          "type": "number",
          "enum": [
            0.125,
            0.25,
            0.5,
            0.75,
            1,
            1.25,
            1.5,
            2,
            4,
            8
          ]
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "step"
              }
            }
          },
          "then": {
            "required": [
              "direction",
              "unit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "shuttle"
              }
            }
          },
          "then": {
            "required": [
              "direction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "speed"
              }
            }
          },
          "then": {
            "required": [
              "rate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "scrub"
              }
            }
          },
          "then": {
            "required": [
              "space",
              "time"
            ]
          }
        }
      ]
    }
  }
