[
  {
    "name": "timeline_item_split",
    "description": "Split the specified clip, assembly range or inserted still with native undo history. Split a still at an interior presentation boundary in sequence or assembly time.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Opaque live document handle from project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Document revision observed by the caller."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique mutation ID. Reuse only for an identical retry."
        },
        "space": {
          "type": "string",
          "enum": [
            "sequence",
            "source",
            "group",
            "assembly"
          ]
        },
        "time": {
          "type": "string",
          "description": "Exact media time as rational seconds, e.g. 1001/30000."
        },
        "occurrence": {
          "oneOf": [
            {
              "type": "string",
              "description": "Ordinary clip occurrence UUID or still placement ID."
            },
            {
              "type": "integer",
              "description": "Revision-scoped multicam assembly occurrence index.",
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "space",
        "time",
        "occurrence"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "timeline_playhead_seek",
    "description": "Seek within the named project. Source time requires a clip occurrence. Multicam group time with an occurrence seeks that use in assembly preview; an occurrence supplied with assembly time must match the position.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Opaque live document handle from project_windows_list."
        },
        "space": {
          "type": "string",
          "enum": [
            "sequence",
            "source",
            "group",
            "assembly"
          ]
        },
        "time": {
          "type": "string",
          "description": "Exact media time as rational seconds, e.g. 1001/30000."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Pin the seek to the document revision used to resolve the occurrence."
        },
        "occurrence": {
          "description": "Clip UUID for an ordinary editor, or zero-based assembly occurrence index for multicam.",
          "oneOf": [
            {
              "type": "string",
              "description": "Ordinary clip occurrence UUID or still placement ID."
            },
            {
              "type": "integer",
              "description": "Revision-scoped multicam assembly occurrence index.",
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "project_handle",
        "space",
        "time"
      ],
      "additionalProperties": false
    }
  },
