  {
    "name": "sequence_clip_edit",
    "description": "Edit one clip occurrence. Trim previews return a token for committing or cancelling the proposed boundary.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Opaque live document handle from project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Document revision observed by the caller."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique mutation ID. Reuse only for an identical retry."
        },
        "action": {
          "type": "string",
          "enum": [
            "copy_container",
            "move",
            "trim",
            "restore_edge",
            "delete_clip",
            "apply_csv",
            "preview_trim",
            "cancel_trim"
          ]
        },
        "occurrence": {
          "type": "string",
          "description": "Clip occurrence UUID from project_editor_state_read."
        },
        "time": {
          "type": "string",
          "description": "Exact media time as rational seconds, e.g. 1001/30000."
        },
        "value": {
          "type": "string",
          "description": "Snap target off, keyframes, scenes, or silence, or a copy container extension supported by this sequence."
        },
        "slot": {
          "type": "integer",
          "description": "Insertion slot before moving, 0 through clip count.",
          "minimum": 0
        },
        "edge": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "path": {
          "type": "string",
          "description": "Absolute input CSV path."
        },
        "trim_preview": {
          "type": "string",
          "format": "uuid",
          "description": "Receipt identifying your active trim preview. Use it to preview or commit the same occurrence and edge, or to cancel."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "copy_container"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "move"
              }
            }
          },
          "then": {
            "required": [
              "occurrence",
              "slot"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "trim"
              }
            }
          },
          "then": {
            "required": [
              "occurrence",
              "edge",
              "time"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "restore_edge"
              }
            }
          },
          "then": {
            "required": [
              "occurrence",
              "edge"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete_clip"
              }
            }
          },
          "then": {
            "required": [
              "occurrence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "apply_csv"
              }
            }
          },
          "then": {
            "required": [
              "occurrence",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "preview_trim"
              }
            }
          },
          "then": {
            "required": [
              "occurrence",
              "edge",
              "time"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "cancel_trim"
              }
            }
          },
          "then": {
            "required": [
              "trim_preview"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "sequence_range_edit",
    "description": "Split or delete the sequence interval between two exact timeline times.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Opaque live document handle from project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Document revision observed by the caller."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique mutation ID. Reuse only for an identical retry."
        },
        "action": {
          "type": "string",
          "enum": [
            "delete_range",
            "split_range"
          ]
        },
        "from": {
          "type": "string",
          "description": "Sequence start time in seconds."
        },
        "to": {
          "type": "string",
          "description": "Sequence end time in seconds."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete_range"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "split_range"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "to"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "timeline_selection_set",
    "description": "Select a timeline occurrence or range, set marks, or change the selection and snapping controls.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Opaque live document handle from project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Document revision observed by the caller."
