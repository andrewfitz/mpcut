[
  {
    "name": "workspace_layout_read",
    "description": "Read a project window’s timeline zoom, native layout, panel state and scroll positions. Returned scroll surface names identify available controls.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_handle"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "workspace_layout_set",
    "description": "Change the layout of the requested editor window.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "zoom_in",
            "zoom_out",
            "set_zoom",
            "fit",
            "restore_zoom",
            "set_large_thumbnails",
            "set_inspector",
            "set_transcript",
            "set_waveform_span",
            "set_pause_controls",
            "set_scroll",
            "set_track_label_width",
            "set_timeline_height",
            "set_inspector_width"
          ]
        },
        "zoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 13,
          "description": "Timeline zoom exponent. A value of 0 fits the timeline, and 1 doubles its width."
        },
        "enabled": {
          "type": "boolean",
          "description": "Used by set_large_thumbnails; shared across windows."
        },
        "span": {
          "type": "string",
          "enum": [
            "timeline_zoom",
            "whole_clip",
            "10_seconds",
            "1_second",
            "100_milliseconds",
            "10_milliseconds"
          ]
        },
        "visible": {
          "type": "boolean",
          "description": "Required for set_pause_controls and set_transcript. Defaults to true for set_inspector."
        },
        "section": {
          "type": "string",
          "enum": [
            "switches",
            "sources",
            "assembly",
            "export",
            "transcript"
          ]
        },
        "surface": {
          "type": "string",
          "enum": [
            "sequence",
            "assembly",
            "group",
            "tracks"
          ]
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of available scroll travel. Zero shows the beginning; one shows the far end."
        },
        "points": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000,
          "description": "Divider size in screen points. Track labels accept 106 to 360. Native layout constraints apply."
        }
      },
      "required": [
        "project_handle",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_zoom"
              }
            }
          },
          "then": {
            "required": [
              "zoom"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_large_thumbnails"
              }
            }
          },
          "then": {
            "required": [
              "enabled"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_waveform_span"
              }
            }
          },
          "then": {
            "required": [
              "span"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_transcript"
              }
            }
          },
          "then": {
            "required": [
              "visible"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_pause_controls"
              }
            }
          },
          "then": {
            "required": [
              "visible"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_scroll"
              }
            }
          },
          "then": {
            "required": [
              "surface",
              "fraction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_track_label_width"
              }
            }
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_timeline_height"
              }
            }
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_inspector_width"
              }
            }
          },
          "then": {
            "required": [
              "points"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "workspace_panel_show",
    "description": "Show the requested app or project panel.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "show_about",
            "show_settings",
            "show_help",
            "show_last_export"
          ]
        },
        "topic": {
          "type": "string",
          "enum": [
            "guide",
            "agent_guide",
            "release_notes"
          ]
        }
      },
      "required": [
        "project_handle",
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "timeline_time_reveal",
    "description": "Reveal the requested exact time on a horizontal timeline surface.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "enum": [
            "sequence",
            "assembly",
            "group"
          ]
        },
        "time": {
          "type": "string",
          "description": "For reveal_time, a rational timestamp in the named sequence, assembly or group clock. Scrolls the time into view without moving the playhead."
        }
      },
      "required": [
        "project_handle",
        "surface",
        "time"
      ],
      "additionalProperties": false
    }
  }
]
