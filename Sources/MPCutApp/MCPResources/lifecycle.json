              }
            ]
          }
        },
        "opening": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "follow",
                "none",
                "fixed"
              ]
            },
