      "additionalProperties": false
    }
  },
  {
    "name": "project_media_add",
    "description": "Add local recordings using the native editor. In a sequence, append or insert at index; in a multicam editor this opens source setup. Read editor state after partial import.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1,
          "description": "Live handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique operation ID for identical retries."
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/",
            "description": "Absolute local filesystem path."
          },
          "minItems": 1,
          "maxItems": 512
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "paths"
      ],
      "additionalProperties": false
    }
  },
  {
