[
  {
    "name": "get_preferences",
    "description": "Read shared MPCut settings and inspect the local-control toggle.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "set_preference",
    "description": "Change a native preference. Lowering historyLimit immediately trims retained history in open projects. Local MCP access is controlled in Settings.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operationID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique operation ID for identical retries."
        },
        "key": {
          "type": "string",
          "enum": [
            "historyLimit",
            "useAnalysisSidecars",
            "defaultExportMode",
            "snapTarget",
            "largeThumbnails",
            "minimumPause",
            "leavePause",
            "volume",
            "isMuted",
            "scrubSoundEnabled",
            "jpegPreset"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "historyLimit 0–500, volume 0–1, pause durations in seconds. Enum values match get_preferences."
        }
      },
      "required": [
        "operationID",
        "key",
        "value"
      ],
      "allOf": [
        {
          "if": { "properties": { "key": { "const": "historyLimit" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 500 } } }
        },
        {
          "if": { "properties": { "key": { "const": "volume" } } },
          "then": { "properties": { "value": { "type": "number", "minimum": 0, "maximum": 1 } } }
        },
        {
          "if": { "properties": { "key": { "const": "minimumPause" } } },
          "then": { "properties": { "value": { "type": "number", "minimum": 0.02 } } }
        },
        {
          "if": { "properties": { "key": { "const": "leavePause" } } },
          "then": { "properties": { "value": { "type": "number", "minimum": 0 } } }
        },
        {
          "if": { "properties": { "key": { "enum": ["useAnalysisSidecars", "largeThumbnails", "isMuted", "scrubSoundEnabled"] } } },
          "then": { "properties": { "value": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "key": { "const": "defaultExportMode" } } },
          "then": { "properties": { "value": { "enum": ["copy", "smart", "encode"] } } }
        },
        {
          "if": { "properties": { "key": { "const": "snapTarget" } } },
          "then": { "properties": { "value": { "enum": ["off", "keyframes", "scenes", "silence"] } } }
        },
        {
          "if": { "properties": { "key": { "const": "jpegPreset" } } },
          "then": { "properties": { "value": { "enum": ["review", "full"] } } }
        }
      ],
      "additionalProperties": false
    }
  },
