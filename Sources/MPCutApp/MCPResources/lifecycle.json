[
  {
    "name": "preferences_read",
    "description": "Read shared MPCut settings and inspect the local-control toggle.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "preferences_set",
    "description": "Change a native preference. Lowering history_max_steps immediately trims retained history in open projects. Local MCP access is controlled in Settings.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique operation ID for identical retries."
        },
        "key": {
          "type": "string",
          "enum": [
            "history_max_steps",
            "analysis_sidecar_reuse_enabled",
            "media_auto_refresh_enabled",
            "export_tier_downgrade_warning_enabled",
            "export_movie_default_mode",
            "timeline_snap_target",
            "timeline_large_previews_enabled",
            "silence_min_pause_seconds",
            "silence_max_blip_seconds",
            "silence_padding_per_side_seconds",
            "playback_preview_volume_fraction",
            "playback_preview_muted",
            "playback_scrub_audio_enabled",
            "export_jpeg_default_preset"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "history_max_steps 0–500, playback_preview_volume_fraction 0–1, silence_max_blip_seconds 0–1 second, pause durations in seconds. Enum values match preferences_read."
        }
      },
      "required": [
        "operation_id",
        "key",
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "history_max_steps"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 500
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "enum": [
                  "playback_preview_volume_fraction",
                  "silence_max_blip_seconds"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "silence_min_pause_seconds"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0.02
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "silence_padding_per_side_seconds"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "enum": [
                  "media_auto_refresh_enabled",
                  "export_tier_downgrade_warning_enabled",
                  "analysis_sidecar_reuse_enabled",
                  "timeline_large_previews_enabled",
                  "playback_preview_muted",
                  "playback_scrub_audio_enabled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "export_movie_default_mode"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "copy",
                  "smart",
                  "encode"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "timeline_snap_target"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "off",
                  "keyframes",
                  "scenes",
                  "silence"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "export_jpeg_default_preset"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "review",
                  "full"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "project_drafts_list",
