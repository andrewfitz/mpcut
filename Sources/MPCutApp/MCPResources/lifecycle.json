  {
    "name": "multicam_setup",
    "description": "Confirm or dismiss native multicam source setup. For creation you can choose opening camera and program audio. Options use the source IDs from get_multicam_setup.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Live handle returned by list_projects."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique operation ID for identical retries."
        },
        "action": {
          "type": "string",
          "enum": [
            "confirm",
            "dismiss"
          ]
        },
        "sourceOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "names": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "audioStreams": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
