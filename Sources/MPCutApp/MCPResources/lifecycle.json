  {
    "name": "project_create",
    "description": "Create a new ordinary sequence or multicam project window. Supply local recording paths for initial import. Multicam requires a camera and opens the setup sheet.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique operation ID for identical retries."
        },
        "kind": {
          "type": "string",
          "enum": [
            "sequence",
            "multicam"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/",
            "description": "Absolute local filesystem path."
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "required": [
        "operation_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "project_open",
    "description": "Open a saved MPCut project and wait for native document loading. An already-open document is activated.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique operation ID for identical retries."
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Absolute local filesystem path."
        }
      },
      "required": [
        "operation_id",
        "project_path"
      ],
      "additionalProperties": false
    }
  },
  {
