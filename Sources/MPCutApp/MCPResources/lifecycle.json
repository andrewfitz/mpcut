        },
        "kind": {
          "type": "string",
          "enum": [
            "sequence",
            "multicam"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/",
            "description": "Absolute local filesystem path."
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "required": [
        "operationID"
      ],
      "additionalProperties": false
    }
  },
