[
  {
    "name": "review_editor_frame_read",
    "description": "Return one JPEG from the current in-memory program at the playhead or at an exact sequence, group or assembly time. Output applies tile layouts and feed treatments. Choose Source to inspect an untreated recording. An explicit angle_id also selects Source when view is omitted. The longest image edge is at most 640 pixels.",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "time": {
          "type": "string",
          "description": "Rational seconds such as 1001/30000. Supply space with time."
        },
        "space": {
          "type": "string",
          "enum": [
            "sequence",
            "group",
            "assembly"
          ]
        },
        "view": {
          "type": "string",
          "enum": [
            "output",
            "source"
          ],
          "description": "Output shows the rendered program. Source shows the untreated recording for correction and review."
        },
        "angle_id": {
          "type": "string",
          "minLength": 1,
          "description": "A multicam camera ID for Source review. Omit to use the camera selected at that time."
        }
      },
      "required": [
        "project_handle"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "angle_id",
              "view"
            ]
          },
          "then": {
            "properties": {
              "view": {
                "const": "source"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "time"
            ]
          },
          "then": {
            "required": [
              "space"
            ]
          }
        },
        {
          "if": {
            "required": [
              "space"
            ]
          },
          "then": {
            "required": [
              "time"
            ]
          }
        }
      ]
    }
  }
]
