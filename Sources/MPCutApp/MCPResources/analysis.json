        "source_id": {
          "type": "string"
        },
        "silence_threshold_db": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -120,
          "maximum": 0
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
