  {
    "name": "timeline_editor_join_preview",
    "description": "Open a short replayable audition around an existing join. Specify one of before_clip_id for a sequence item, before_occurrence for a multicam assembly item, or switch_time for a saved multicam switch. Close it with silence_editor_pause_review action done.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string"
        },
        "before_clip_id": {
          "type": "string",
          "description": "Sequence timeline item ID immediately after the join."
        },
        "before_occurrence": {
          "type": "integer",
          "minimum": 1,
          "description": "Zero-based multicam assembly index immediately after the join."
        },
        "switch_time": {
          "type": "string",
          "description": "Exact group time of a saved multicam switch."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id"
      ],
      "additionalProperties": false
    }
