  {
    "name": "silence_editor_pause_review",
    "description": "Seek, preview, protect or unprotect a pause by its silence_editor_pauses_list ID. Multicam protection applies to the group-time pause across repeated occurrences. Protecting the auditioned multicam pause closes its review. Done closes the review. Use set_retained with a nonnegative total duration in seconds, or reset_retained, for one detected pause in its occurrence. next_cut and keep_and_advance operate on an open detected-pause review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string"
        },
        "pause": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "seek",
            "preview",
            "protect",
            "unprotect",
            "set_retained",
            "reset_retained",
            "next_cut",
            "keep_and_advance",
            "done"
          ]
        },
        "retained_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "project_handle",
        "action",
        "expected_revision",
        "operation_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "silence_editor_take_candidates_list",
