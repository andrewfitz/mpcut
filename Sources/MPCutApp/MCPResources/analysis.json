  {
    "name": "silence_editor_threshold_set",
    "description": "Set the silence threshold in dBFS. A null threshold selects automatic detection. A sequence threshold applies to the named source or the source at the playhead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
