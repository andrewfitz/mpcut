[
  {
    "name": "analysis_editor_state_read",
    "description": "Read scene and silence scan status, scene coverage, current scene selection, media refresh status and issues, settings, and a bounded page of source IDs and absolute audio stream indices.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "project_handle"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "silence_editor_pauses_list",
    "description": "Read detected pauses, proposed removals, clock and protection state from the current sequence or multicam assembly. Use the returned pause ID for review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "project_handle"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "scenes_editor_boundaries_list",
    "description": "Read exact source-relative scene boundaries and recurring views for a source or a sequence clip.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "clip_id": {
          "type": "string",
          "format": "uuid",
          "description": "Sequence occurrence ID. Read the report that covers the clip’s current source interval."
        },
        "include_stale": {
          "type": "boolean",
          "description": "Prefer the archived report from a prior source generation when available. Archived rows carry their stale reason and original source stamp."
        }
      },
      "required": [
        "project_handle"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "source_id"
          ]
        },
        {
          "required": [
            "clip_id"
          ]
        }
      ]
    }
  },
  {
    "name": "waveform_editor_peaks_read",
    "description": "Read linear-amplitude peak bins from a completed native waveform on the selected sequence track or a routed multicam track. Unobserved bins are null. Stream uses an absolute stream index. Use waveform_editor_envelope_read for a signed envelope or another indexed stream.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "audio_stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "source_from": {
          "type": "string"
        },
        "source_to": {
          "type": "string"
        }
      },
      "required": [
        "project_handle",
        "source_id",
        "audio_stream_index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "scenes_editor_scan",
    "description": "Scan scenes in the open editor. Select the whole project or a source using scope and target.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "selected"
          ],
          "description": "Scene scope. All scans every referenced recording. Selected scans a sequence clip’s source interval or a multicam recording."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Clip UUID from project_editor_state_read or camera ID from multicam_state_read. Applies to selected scope and defaults to the current editor selection."
        },
        "policy": {
          "type": "string",
          "enum": [
            "reuse",
            "resume",
            "restart"
          ],
          "description": "Reuse returns current results or resumes unfinished analysis. Resume prefers a saved replacement attempt. Restart begins a replacement identified by operation_id."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "silence_editor_scan",
