          "additionalProperties": false
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "replacement_stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "replacement_source_id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "metadata_only": {
          "type": "boolean"
        },
        "program": {
          "type": "boolean",
