[
  {
    "name": "multicam_camera_take",
    "description": "Take a camera by angle ID or displayed number at an explicit group time with native snapping and history. Returns the actual time and end of the affected switch interval.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Revision from project_editor_state_read."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "angle_id": {
          "type": "string",
          "description": "Stable camera source ID from the live project."
        },
        "camera_number": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based displayed camera number from the current revision."
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional source-backed assembly occurrence from the current revision."
        },
        "group_time": {
          "type": "string",
          "description": "Exact rational seconds on the multicam group clock."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "group_time"
      ],
      "oneOf": [
        {
          "required": [
            "angle_id"
          ]
        },
        {
          "required": [
            "camera_number"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_switch_edit",
    "description": "Edit an existing group switch at time. move/apply_suggestion require to, angle requires angle, audio requires source and stream. default_audio restores project routing.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Revision from project_editor_state_read."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "action": {
          "type": "string",
          "enum": [
            "move",
            "apply_suggestion",
            "delete",
            "angle",
            "audio",
            "default_audio"
          ]
        },
        "time": {
          "type": "string",
          "description": "Exact rational seconds on the multicam group clock."
        },
        "to": {
          "type": "string",
          "description": "Exact rational seconds on the multicam group clock."
        },
        "angle_id": {
          "type": "string",
          "description": "Stable camera source ID from the live project."
        },
        "source_id": {
          "type": "string",
          "description": "Stable ID of a camera or separate audio source."
        },
        "audio_stream_index": {
          "type": "integer",
          "description": "Absolute audio stream index in the indicated source."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action",
        "time"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_source_edit",
    "description": "Edit a camera or recorder. rename requires name; offset requires offset; nudge/move require direction; nudge also accepts a group time; microphone sets stream (omit to clear); relink uses project_editor_media_relink and requires the same recording at an absolute path; add_recording requires angle_id, an absolute path and group_start.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Revision from project_editor_state_read."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "action": {
          "type": "string",
          "enum": [
            "rename",
            "offset",
            "nudge",
            "move",
            "microphone",
            "relink",
            "add_recording"
          ]
        },
        "source_id": {
          "type": "string",
          "description": "Stable recording ID. Required except for add_recording."
        },
        "angle_id": {
          "type": "string",
          "description": "Camera angle ID for add_recording."
        },
        "group_start": {
          "type": "string",
          "description": "Exact group time at which the new recording’s first picture appears."
        },
        "name": {
          "type": "string",
          "description": "Display name; empty restores default."
        },
        "offset": {
          "type": "string",
          "description": "Exact sync offset in rational seconds."
        },
        "time": {
          "type": "string",
          "description": "Group time for the frame or audio sample used by nudge. Omit to use the current group playhead."
        },
        "direction": {
          "type": "integer",
          "enum": [
            -1,
            1
          ]
        },
        "audio_stream_index": {
          "type": "integer",
          "description": "Absolute audio stream index in the indicated source."
        },
        "path": {
          "type": "string",
          "description": "Absolute replacement or additional recording path."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_program_audio_set",
    "description": "Set Fixed, Follow, None or Mix audio. Mix accepts an ordered lane list. Replace applies one soundtrack and clears switch overrides. For an external replacement, supply a reference_source_id and confirmed relative_offset to align the incoming sound.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Revision from project_editor_state_read."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixed",
            "follow",
            "none",
            "replace",
            "mix"
          ]
        },
        "source_id": {
          "type": "string",
          "description": "Stable ID of a camera or separate audio source."
        },
        "audio_stream_index": {
          "type": "integer",
          "description": "Absolute audio stream index in the indicated source."
        },
        "replacement": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path to an external replacement recording."
        },
        "replacement_audio_stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "color_slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "target": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "camera"
                        ]
                      },
                      "angle_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "angle_id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "recording"
                        ]
                      },
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "audio_stream_index": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "source_id",
                      "audio_stream_index"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "label",
              "color_slot",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "reference_source_id": {
          "type": "string",
          "minLength": 1,
          "description": "Camera recording ID for an aligned program replacement."
        },
        "relative_offset": {
          "type": "string",
          "minLength": 1,
          "description": "Confirmed rational offset relative to the reference recording."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "mode"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "mode": {
              "enum": [
                "none",
                "follow"
              ]
            }
          },
          "allOf": [
            {
              "not": {
                "required": [
                  "source_id"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "audio_stream_index"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "replacement"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "replacement_audio_stream_index"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "lanes"
                ]
              }
            }
          ]
        },
        {
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "replace"
              ]
            }
          },
          "required": [
            "source_id",
            "audio_stream_index"
          ],
          "allOf": [
            {
              "not": {
                "required": [
                  "replacement"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "replacement_audio_stream_index"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "lanes"
                ]
              }
            }
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "replace"
            }
          },
          "required": [
            "replacement"
          ],
          "allOf": [
            {
              "not": {
                "required": [
                  "source_id"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "audio_stream_index"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "lanes"
                ]
              }
            }
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "mix"
            }
          },
          "required": [],
          "allOf": [
            {
              "not": {
                "required": [
                  "source_id"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "audio_stream_index"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "replacement"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "replacement_audio_stream_index"
                ]
              }
            }
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "fixed"
            }
          },
          "required": [],
          "allOf": [
            {
              "not": {
                "required": [
                  "source_id"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "audio_stream_index"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "replacement"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "replacement_audio_stream_index"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "lanes"
                ]
              }
            }
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "reference_source_id"
            ]
          },
          "then": {
            "required": [
              "reference_source_id",
              "relative_offset",
              "replacement",
              "replacement_audio_stream_index"
            ],
            "properties": {
              "mode": {
                "const": "replace"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "relative_offset"
            ]
          },
          "then": {
            "required": [
              "reference_source_id",
              "relative_offset",
              "replacement",
              "replacement_audio_stream_index"
            ],
            "properties": {
              "mode": {
                "const": "replace"
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "multicam_group_end_set",
    "description": "Set the group end using time or extend to the last available camera.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Revision from project_editor_state_read."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "action": {
          "type": "string",
          "enum": [
            "set_end",
            "extend"
          ]
        },
        "time": {
          "type": "string",
          "description": "Exact rational seconds on the multicam group clock."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_assembly_edit",
    "description": "Edit retained occurrences. append requires group from/to; trim requires occurrence and from or to; move requires occurrence and before; remove requires an explicit occurrence. Removing the last explicit occurrence restores the implicit full group. Selection actions require space, from and to matching the selected range; read those values from multicam_selection_set. Use trim_edge or preview_trim with occurrence, edge and group time for native handle snapping. apply_edge_suggestion moves the unsafe range edge reported by multicam_state_read suggestions to one of its verified times in to. Set a picture-only occurrence override with angle_set (occurrence and angle_id), or restore group picture switches with angle_clear (occurrence).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Revision from project_editor_state_read."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "action": {
          "type": "string",
          "enum": [
            "append",
            "trim",
            "move",
            "remove",
            "split_selection",
            "subtract_selection",
            "trim_edge",
            "preview_trim",
            "apply_edge_suggestion",
            "angle_set",
            "angle_clear"
          ]
        },
        "occurrence": {
          "type": "integer",
          "description": "Zero-based assembly occurrence."
        },
        "before": {
          "type": "integer",
          "description": "Zero-based insertion slot before removal, from 0 through count."
        },
        "from": {
          "type": "string",
          "description": "Exact rational seconds on the group clock for append or trim, or the selected clock for a selection edit."
        },
        "to": {
          "type": "string",
          "description": "Exact rational seconds on the group clock for append or trim, or the selected clock for a selection edit."
        },
        "edge": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "time": {
          "type": "string",
          "description": "Group time for a snapped trim edge."
        },
        "space": {
          "type": "string",
          "enum": [
            "group",
            "assembly"
          ]
        },
        "angle_id": {
          "type": "string",
          "description": "Camera angle ID for angle_set."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_selection_set",
    "description": "Select a switch at group time, occurrence by index, a range with from/to in the named clock, tool or marks in this window.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Required when selecting an occurrence from an assembly with still inserts."
        },
        "action": {
          "type": "string",
          "enum": [
            "switch",
            "occurrence",
            "group_range",
            "assembly_range",
            "mark_in",
            "mark_out",
            "clear_marks",
            "pointer",
            "range_tool"
          ]
        },
        "time": {
          "type": "string",
          "description": "Exact rational seconds on the multicam group clock."
        },
        "occurrence": {
          "type": "integer",
          "description": "Zero-based assembly occurrence."
        },
        "from": {
          "type": "string",
          "description": "Inclusive range start, rational seconds."
        },
        "to": {
          "type": "string",
          "description": "Exclusive range end, rational seconds."
        }
      },
      "required": [
        "project_handle",
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_preview_control",
    "description": "Set preview mode or transport. audition takes angle; speed takes a rate; shuttle and step actions take direction; snap takes target.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "action": {
          "type": "string",
          "enum": [
            "group",
            "assembly",
            "audition",
            "program",
            "shuttle",
            "speed",
            "step",
            "step_keyframe",
            "step_scene",
            "step_pause",
            "start",
            "end",
            "snap",
            "scrub_group",
            "scrub_assembly",
            "end_scrub"
          ]
        },
        "angle_id": {
          "type": "string",
          "description": "Stable camera source ID from the live project."
        },
        "speed": {
          "type": "number",
          "enum": [
            0.125,
            0.25,
            0.5,
            0.75,
            1,
            1.25,
            1.5,
            2,
            4,
            8
          ]
        },
        "direction": {
          "type": "integer",
          "enum": [
            -1,
            1
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "off",
            "keyframes",
            "scenes",
            "silence"
          ]
        },
        "time": {
          "type": "string",
          "description": "Scrub position in the specified clock, rational seconds."
        }
      },
      "required": [
        "project_handle",
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_voice_angle_edit",
    "description": "Set a persistent link from a transcript attachment and speaker to a camera angle. Clear it to resume automatic matching. Read explicit links in multicam_state_read with section voice_angles.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "action": {
          "type": "string",
          "enum": ["set", "clear"]
        },
        "attachment_id": {
          "type": "string",
          "minLength": 1
        },
        "speaker_id": {
          "type": "string",
          "minLength": 1
        },
        "angle_id": {
          "type": "string",
          "minLength": 1,
          "description": "Required for set."
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "action",
        "attachment_id",
        "speaker_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_state_read",
    "description": "Inspect the live group, program audio and reference camera. Page sources with offsets, index issues and stream IDs, switches with overrides, persistent transcript voice links, suggested switch boundaries and range edges, assembly occurrences, or still placements. For switch_coverage, supply group_time and angle_id to check the proposed snapped interval before committing a take. The audio section gives the saved Mix lanes and bindings and the resolved program spans and gaps.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "enum": [
            "sources",
            "switches",
            "suggestions",
            "assembly",
            "stills",
            "switch_coverage",
            "audio",
            "voice_angles"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "angle_id": {
          "type": "string",
          "description": "Camera angle ID for switch_coverage."
        },
        "group_time": {
          "type": "string",
          "description": "Requested exact group time for switch_coverage."
        }
      },
      "required": [
        "project_handle",
        "section"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "multicam_track_audio_edit",
    "description": "Apply a confirmed rational replacement offset relative to a recording, or remove its binding. Applies to the selected original stream across audio policies.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_handle": {
          "type": "string",
          "description": "Live project handle returned by project_windows_list."
        },
        "expected_revision": {
          "type": "integer",
          "description": "Revision from project_editor_state_read."
        },
        "operation_id": {
          "type": "string",
          "description": "Unique operation ID for this edit. Retry the same request with the same ID."
        },
        "action": {
          "type": "string",
          "enum": [
            "set",
            "remove"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "original": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "audio_stream_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "source_id",
            "audio_stream_index"
          ],
          "additionalProperties": false
        },
        "replacement": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "audio_stream_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "source_id",
            "audio_stream_index"
          ],
          "additionalProperties": false
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "replacement_stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "replacement_source_id": {
          "type": "string",
          "minLength": 1
        },
        "relative_offset": {
          "type": "string",
          "minLength": 1
        },
        "uncovered": {
          "type": "string",
          "enum": [
            "keep_original",
            "leave_uncovered"
          ]
        }
      },
      "required": [
        "project_handle",
        "expected_revision",
        "operation_id",
        "action",
        "id"
      ],
