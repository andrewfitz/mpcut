        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "description": "Unique operation identifier; repeat the exact request after a lost reply."
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
