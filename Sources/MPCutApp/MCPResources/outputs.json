        "expectedRevision",
        "operationID",
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "render_project",
    "description": "Check or render a live sequence or multicam snapshot. Use mode copy to remux compatible streams. Poll live_job_status. When preflight reports eligible false, inspect result.alternatives for verified modes and containers. Ordinary copy preflight can also offer revised boundaries.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Live project handle from list_projects."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "description": "Unique operation identifier; repeat the exact request after a lost reply."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute local output path. Existing media destinations are protected."
        },
        "scope": {
          "type": "string",
          "enum": [
            "timeline",
            "selection",
            "group"
          ]
        },
        "tracks": {
          "type": "string",
          "enum": [
            "all",
            "video",
            "audio"
          ]
        },
        "requireCameraCopy": {
          "type": "boolean",
          "description": "Require zero encoded camera duration when generating stills."
        },
        "mode": {
          "type": "string",
          "description": "Defaults to Smart Trim for visible still picture. Other outputs use the native defaults.",
          "enum": [
            "smart",
            "copy",
            "encode"
          ]
        },
        "codec": {
          "type": "string",
          "enum": [
            "h264",
            "hevc",
            "prores"
          ]
        },
        "quality": {
          "type": "string",
          "description": "Use smaller, balanced or high for H.264 and HEVC. Use 422-lt, 422 or 422-hq for ProRes. Requires movie encode mode.",
          "enum": [
            "smaller",
            "balanced",
            "high",
            "422-lt",
            "422",
            "422-hq"
          ]
        },
        "audio": {
          "type": "string",
          "enum": [
            "auto",
            "copy",
            "aac",
            "pcm",
            "remove",
            "mp3",
            "flac"
          ]
        },
        "audioTrackOrdinal": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based track within the ordinary source audio tracks."
        },
        "dryRun": {
          "type": "boolean",
          "description": "Defaults to true. Pass false to write output."
        },
        "useReviewedCuts": {
          "type": "boolean",
          "description": "Use the native verified copy-boundary proposal for this ordinary export only. The timeline and its history stay intact."
        }
      },
      "required": [
        "project",
        "expectedRevision",
        "operationID",
        "output"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "apply_export_review",
    "description": "Apply one verified boundary change as a native undo step. Use render_project with dryRun first. For a still-bearing timeline supply the exact still adjustment from its camera-copy preflight.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Live project handle from list_projects."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "description": "Unique operation identifier; repeat the exact request after a lost reply."
        },
        "mode": {
          "type": "string",
          "enum": ["smart", "copy"],
          "description": "Mode used to review the still boundary. Defaults to smart."
        },
        "tracks": {
          "type": "string",
          "enum": ["all", "video"],
          "description": "Tracks used to review the still boundary. Defaults to all."
        },
        "audio": {
          "type": "string",
          "enum": ["auto", "copy", "aac", "pcm", "remove"],
          "description": "Sound action used to review the still boundary."
        },
        "stillAdjustment": {
          "type": "object",
          "description": "Exact adjustment from result.issue.stillBoundaryAdjustments for a whole-timeline dry run with requireCameraCopy.",
          "properties": {
            "placementID": {"type": "string", "minLength": 1},
            "boundary": {"type": "string", "enum": ["start", "end", "insertion"]},
            "clock": {"type": "string", "enum": ["source", "group", "sequence", "assembly"]},
            "occurrenceID": {"type": "string", "minLength": 1},
            "requestedTime": {"type": "object", "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}, "required": ["numerator", "denominator"], "additionalProperties": false},
            "adjustedTime": {"type": "object", "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}, "required": ["numerator", "denominator"], "additionalProperties": false},
            "durationChange": {"type": "object", "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}, "required": ["numerator", "denominator"], "additionalProperties": false}
          },
          "required": ["placementID", "boundary", "clock", "requestedTime", "adjustedTime", "durationChange"],
          "additionalProperties": false
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute local output path. Existing media destinations are protected."
        }
      },
      "required": [
        "project",
        "expectedRevision",
        "operationID",
        "output"
      ],
      "additionalProperties": false
    }
  },
