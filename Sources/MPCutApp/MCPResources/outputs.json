[
  {
    "name": "get_export_queue",
    "description": "Read the native export queue. Each entry includes its identifier and exact marked range.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Live project handle from list_projects."
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_export_range",
    "description": "Add the current marked range to the native queue, preserving the captured edit and media.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Live project handle from list_projects."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "description": "Unique operation identifier; repeat the exact request after a lost reply."
        }
      },
      "required": [
        "project",
        "expectedRevision",
        "operationID"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_export_range",
