          "type": "string",
          "minLength": 1,
          "description": "Live project handle from list_projects."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "description": "Unique operation identifier; repeat the exact request after a lost reply."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute local output path. Existing media destinations are protected."
        },
        "allowLoss": {
          "type": "boolean"
        },
        "flattenMulticam": {
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "expectedRevision",
        "operationID",
        "output"
      ],
      "additionalProperties": false
    }
  },
