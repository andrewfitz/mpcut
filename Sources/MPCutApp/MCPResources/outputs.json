  {
    "name": "export_review_frames",
    "description": "Export review JPEGs from the live editor. Still and playhead selections sample the program when still placements exist. Supply space to sample exact program times. With no space, times follow native source or multicam group and angle review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Live project handle from list_projects."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "description": "Unique operation identifier; repeat the exact request after a lost reply."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute local output path. Existing media destinations are protected."
        },
        "selection": {
          "type": "string",
          "enum": [
            "playhead",
            "still",
            "times",
            "switches",
            "scenes",
            "nonSilent"
          ]
        },
        "space": {
          "type": "string",
          "enum": ["sequence", "group", "assembly"],
          "description": "Select the program clock for still, playhead or explicit time samples. Omit for the native source and angle review modes."
        },
        "times": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "preset": {
          "type": "string",
          "enum": [
            "review",
            "full"
          ]
        },
        "sample": {
          "type": "string",
          "enum": [
            "first",
            "midpoint"
          ]
        },
        "limit": {
          "type": "integer",
          "description": "Optional maximum frame count for scene or non-silent sampling.",
          "minimum": 1
        }
      },
      "required": [
        "project",
        "expectedRevision",
        "operationID",
        "output"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "convert_live_project",
    "description": "Export the current unsaved edit as a new .cut, .drp, .drt, .prproj, .fcpxml, .fcpxmld or .fcpbundle. Host applications may be required. Poll live_job_status for warnings and actual output paths.",
    "inputSchema": {
      "type": "object",
      "properties": {
