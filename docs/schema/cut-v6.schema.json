{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpcut:cut:6",
  "title": "MPCut still sequence project v6",
  "$defs": {
    "sequence": {
      "type": "object",
      "properties": {
        "format": {
          "const": "mpcut"
        },
        "schema_version": {
          "const": 6
        },
        "kind": {
          "const": "sequence"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequenceItem"
          }
        },
        "history": {
          "$ref": "#/$defs/sequenceHistory"
        },
        "media_snapshot": {
          "$ref": "#/$defs/mediaSnapshot"
        },
        "still_assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stillAsset"
          }
        },
        "still_replacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequenceReplacement"
          }
        },
        "program_color_policy": {
          "$ref": "#/$defs/programColorPolicy"
        },
        "still_format": {
          "$ref": "#/$defs/stillFormat"
        },
        "transcripts": {
          "$ref": "#/$defs/transcripts"
        },
        "source_selects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSelect"
          }
        },
        "participants": {
          "$ref": "#/$defs/participants"
        },
        "still_soundtrack": {
          "$ref": "#/$defs/stillSoundtrack"
        }
      },
      "required": [
        "format",
        "schema_version",
        "kind",
        "clips"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "still_soundtrack": [
          "still_format"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "still_format"
            ]
          },
          "then": {
            "properties": {
              "clips": {
                "items": {
                  "$ref": "#/$defs/stillSequenceItem"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "clips": {
                "contains": {
                  "required": [
                    "still"
                  ],
                  "properties": {
                    "still": {
                      "required": [
                        "exact_duration"
                      ],
                      "properties": {
                        "exact_duration": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "still_format"
            ]
          }
        }
      ]
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "from": {
          "$ref": "#/$defs/time"
        },
        "to": {
          "$ref": "#/$defs/time"
        },
        "original_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "track_ordinal": {
          "anyOf": [
            {
              "$ref": "#/$defs/stream"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacement_names": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "file",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "sourceSelect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stillID"
        },
        "name": {
          "$ref": "#/$defs/stillID"
        },
        "range": {
          "type": "object",
          "properties": {
            "file": {
              "allOf": [
                {
                  "$ref": "#/$defs/file"
                },
                {
                  "$ref": "#/$defs/stillID"
                }
              ]
            },
            "from": {
              "$ref": "#/$defs/time"
            },
            "to": {
              "$ref": "#/$defs/time"
            }
          },
          "required": [
            "file",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "range"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/time"
        },
        "to": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "audio_stream_index": {
          "$ref": "#/$defs/stream"
        }
      },
      "required": [
        "source_id",
        "audio_stream_index"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:[^\\u0000]*/)?\\.{1,2}$)[^\\u0000]*[^/\\u0000]$"
    },
    "time": {
      "type": "string",
      "pattern": "^[+-]?(?:[0-9]+/[0-9]*[1-9][0-9]*|(?:[0-9]+:(?:0*[0-5]?[0-9]:)?0*[0-5]?[0-9]|[0-9]+)(?:\\.[0-9]+)?|\\.[0-9]+)$"
    },
    "stream": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "sequenceStep": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/historyAction"
        },
        "origin": {
          "enum": [
            "user",
            "agent",
            "unknown"
          ]
        },
        "clips": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/sequenceItem"
              }
            ]
          },
          "maxItems": 1000000
        },
        "still_assets": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/stillAsset"
              }
            ]
          }
        },
        "still_replacements": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/sequenceReplacement"
              }
            ]
          }
        },
        "program_color_policy": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/programColorPolicy"
              }
            ]
          },
          "maxItems": 1
        },
        "still_format": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/stillFormat"
              }
            ]
          },
          "maxItems": 1
        },
        "transcript_authoring": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/transcriptAuthoredRecord"
              }
            ]
          }
        },
        "transcript_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transcriptBindingChange"
          }
        },
        "source_selects": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/sourceSelect"
              }
            ]
          }
        },
        "participants": {
          "$ref": "#/$defs/participants"
        },
        "still_soundtrack": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/stillSoundtrack"
              }
            ]
          }
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "sequenceHistory": {
      "type": "object",
      "properties": {
        "undo": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/sequenceStep"
          }
        },
        "redo": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/sequenceStep"
          }
        }
      },
      "additionalProperties": false
    },
    "historyAction": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 1024
    },
    "historyCopy": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "sequenceItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/clip"
        },
        {
          "$ref": "#/$defs/stillSequenceItem"
        }
      ]
    },
    "stillID": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "stillAsset": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/stillID"
            },
            "file": {
              "$ref": "#/$defs/file"
            },
            "display_name": {
              "$ref": "#/$defs/stillID"
            },
            "fingerprint": {
              "$ref": "#/$defs/stillID"
            }
          },
          "required": [
            "id",
            "file",
            "display_name",
            "fingerprint"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/stillID"
            },
            "kind": {
              "const": "gap"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stillInsert": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stillID"
        },
        "asset_id": {
          "$ref": "#/$defs/stillID"
        },
        "duration": {
          "$ref": "#/$defs/time"
        },
        "cadence": {
          "$ref": "#/$defs/time"
        },
        "framing": {
          "$ref": "#/$defs/stillFraming"
        },
        "exact_duration": {
          "const": true
        }
      },
      "required": [
        "id",
        "asset_id",
        "duration",
        "cadence",
        "framing"
      ],
      "additionalProperties": false
    },
    "stillFraming": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "fit",
            "fill"
          ]
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/stillCrop"
            },
            {
              "type": "null"
            }
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "mode",
        "background"
      ],
      "additionalProperties": false
    },
    "stillCrop": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/time"
        },
        "y": {
          "$ref": "#/$defs/time"
        },
        "width": {
          "$ref": "#/$defs/time"
        },
        "height": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "sequenceReplacement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stillID"
        },
        "asset_id": {
          "$ref": "#/$defs/stillID"
        },
        "framing": {
          "$ref": "#/$defs/stillFraming"
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stillFragment"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "asset_id",
        "framing",
        "fragments"
      ],
      "additionalProperties": false
    },
    "stillFragment": {
      "type": "object",
      "properties": {
        "clip_id": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      },
      "required": [
        "clip_id",
        "range"
      ],
      "additionalProperties": false
    },
    "programColorPolicy": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "rendition_policy_version": {
          "enum": [
            1,
            2
          ]
        },
        "diffuse_white_nits": {
          "type": "integer",
          "minimum": 1
        },
        "transfer": {
          "$ref": "#/$defs/stillID"
        },
        "primaries": {
          "$ref": "#/$defs/stillID"
        },
        "matrix": {
          "$ref": "#/$defs/stillID"
        },
        "range": {
          "$ref": "#/$defs/stillID"
        },
        "viewing_conditions": {
          "$ref": "#/$defs/stillID"
        }
      },
      "required": [
        "version",
        "rendition_policy_version",
        "diffuse_white_nits",
        "transfer",
        "primaries",
        "matrix",
        "range",
        "viewing_conditions"
      ],
      "additionalProperties": false
    },
    "stillFormat": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8192,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8192,
          "multipleOf": 2
        },
        "cadence": {
          "$ref": "#/$defs/time"
        },
        "codec": {
          "enum": [
            "h264",
            "hevc",
            "prores",
            "jpeg"
          ]
        },
        "container": {
          "enum": [
            "mov",
            "mp4",
            "m4v",
            "mkv"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "cadence",
        "codec",
        "container"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "codec": {
                "const": "jpeg"
              }
            }
          },
          "then": {
            "properties": {
              "container": {
                "enum": [
                  "mov"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "codec": {
                "const": "prores"
              }
            }
          },
          "then": {
            "properties": {
              "container": {
                "enum": [
                  "mov",
                  "mkv"
                ]
              }
            }
          }
        }
      ]
    },
    "transcriptTime": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "transcriptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transcriptAsset": {
      "type": "object",
      "properties": {
        "file": {
          "allOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "pattern": "^(?:[^/]+\\.transcripts|\\.\\./\\.transcripts/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})/[0-9a-f]{64}\\.json$"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/transcriptDigest"
        },
        "unavailable": {
          "enum": [
            "missing",
            "invalid"
          ]
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "transcriptBinding": {
      "type": "object",
      "properties": {
        "source_fingerprint": {
          "$ref": "#/$defs/transcriptDigest"
        },
        "source_confirmed": {
          "type": "boolean"
        },
        "track_id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "audio_stream_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "offset": {
          "$ref": "#/$defs/transcriptTime"
        },
        "sequence_clock_origin": {
          "$ref": "#/$defs/transcriptTime"
        },
        "sequence_stream_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "track_id",
        "audio_stream_index",
        "offset"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "source_id",
              "file"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_confirmed": {
                "const": true
              }
            },
            "required": [
              "source_confirmed"
            ]
          },
          "then": {
            "required": [
              "source_fingerprint"
            ]
          }
        }
      ]
    },
    "transcriptAttachment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset": {
          "$ref": "#/$defs/transcriptAsset"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transcriptBinding"
          }
        },
        "import_origin": {
          "$ref": "#/$defs/transcriptTime"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "asset",
        "bindings"
      ],
      "additionalProperties": false
    },
    "transcriptAnchor": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/transcriptBinding"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "word_count": {
          "type": "integer",
          "minimum": 1
        },
        "word_id_hint": {
          "$ref": "#/$defs/id"
        },
        "wording_hash": {
          "$ref": "#/$defs/transcriptDigest"
        },
        "speaker_lane": {
          "type": "boolean"
        }
      },
      "required": [
        "binding",
        "range",
        "word_count",
        "wording_hash"
      ],
      "additionalProperties": false
    },
    "transcriptAuthoredRecord": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "attachment_id": {
          "$ref": "#/$defs/id"
        },
        "change": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "replace_text": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "replace_text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "assign_speaker": {
                  "type": "object",
                  "properties": {
                    "speaker_id": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "required": [
                    "speaker_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "assign_speaker"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "rename_speaker": {
                  "type": "object",
                  "properties": {
                    "speaker_id": {
                      "$ref": "#/$defs/id"
                    },
                    "name": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "required": [
                    "speaker_id",
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "rename_speaker"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "merge_speakers": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "$ref": "#/$defs/id"
                    },
                    "target_id": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "required": [
                    "source_id",
                    "target_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "merge_speakers"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "match_override": {
                  "type": "object",
                  "properties": {
                    "track_id": {
                      "$ref": "#/$defs/id"
                    },
                    "accepted": {
                      "type": "boolean"
                    },
                    "observation": {
                      "type": "object",
                      "properties": {
                        "range": {
                          "$ref": "#/$defs/range"
                        },
                        "word_id": {
                          "$ref": "#/$defs/id"
                        }
                      },
                      "required": [
                        "range"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "track_id",
                    "accepted"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "match_override"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "named_select": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "required": [
