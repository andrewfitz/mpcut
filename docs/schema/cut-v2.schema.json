{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpcut:cut:2",
  "title": "MPCut project v2",
  "oneOf": [
    {
      "$ref": "#/$defs/sequence"
    },
    {
      "$ref": "#/$defs/multicam"
    }
  ],
  "$defs": {
    "sequence": {
      "type": "object",
      "properties": {
        "format": {
          "const": "mpcut"
        },
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "sequence"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequenceItem"
          }
        },
        "history": {
          "$ref": "#/$defs/sequenceHistory"
        },
        "stillAssets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stillAsset"
          }
        },
        "stillReplacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequenceReplacement"
          }
        },
        "programColorPolicy": {
          "$ref": "#/$defs/programColorPolicy"
        },
        "stillFormat": {
          "$ref": "#/$defs/stillFormat"
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "kind",
        "clips"
      ],
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "from": {
          "$ref": "#/$defs/time"
        },
        "to": {
          "$ref": "#/$defs/time"
        },
        "originalFile": {
          "anyOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "audioTrack": {
          "anyOf": [
            {
              "$ref": "#/$defs/stream"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacementNames": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "file",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "multicam": {
      "type": "object",
      "properties": {
        "format": {
          "const": "mpcut"
        },
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "multicam"
        },
        "referenceAngle": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "angles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "audioSources": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source"
              },
              "minItems": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "switches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/switch"
          },
          "minItems": 1
        },
        "assembly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assemblyItem"
          },
          "minItems": 1
        },
        "history": {
          "$ref": "#/$defs/multicamHistory"
        },
        "stillAssets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stillAsset"
          }
        },
        "stillReplacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/groupReplacement"
          }
        },
        "programColorPolicy": {
          "$ref": "#/$defs/programColorPolicy"
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "kind",
        "referenceAngle",
        "range",
        "angles",
        "audio",
        "switches"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/time"
        },
        "to": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "audioStream": {
          "anyOf": [
            {
              "$ref": "#/$defs/stream"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "file"
      ],
      "additionalProperties": false
    },
    "audio": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "follow"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "source": {
              "$ref": "#/$defs/id"
            },
            "stream": {
              "$ref": "#/$defs/stream"
            }
          },
          "required": [
            "mode",
            "source",
            "stream"
          ],
          "additionalProperties": false
        }
      ]
    },
    "switch": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/time"
        },
        "angle": {
          "$ref": "#/$defs/id"
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/selection"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "at",
        "angle"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/id"
        },
        "stream": {
          "$ref": "#/$defs/stream"
        }
      },
      "required": [
        "source",
        "stream"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:[^\\u0000]*/)?\\.{1,2}$)[^\\u0000]*[^/\\u0000]$"
    },
    "time": {
      "type": "string",
      "pattern": "^[+-]?(?:[0-9]+/[0-9]*[1-9][0-9]*|(?:[0-9]+:(?:0*[0-5]?[0-9]:)?0*[0-5]?[0-9]|[0-9]+)(?:\\.[0-9]+)?|\\.[0-9]+)$"
    },
    "stream": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "sequenceStep": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/historyAction"
        },
        "clips": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/clip"
              }
            ]
          }
        },
        "stillAssets": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/stillAsset"
              }
            ]
          }
        },
        "stillReplacements": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/sequenceReplacement"
              }
            ]
          }
        },
        "programColorPolicy": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/programColorPolicy"
              }
            ]
          },
          "maxItems": 1
        },
        "sequenceItems": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/sequenceItem"
              }
            ]
          }
        },
        "stillFormat": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/stillFormat"
              }
            ]
          },
          "maxItems": 1
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "clips",
          "sequenceItems"
        ]
      }
    },
    "sequenceHistory": {
      "type": "object",
      "properties": {
        "undo": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/sequenceStep"
          }
        },
        "redo": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/sequenceStep"
          }
        }
      },
      "additionalProperties": false
    },
    "multicamStep": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/historyAction"
        },
        "angles": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        },
        "audioSources": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        },
        "switches": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/switch"
              }
            ]
          }
        },
        "assembly": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/range"
              }
            ]
          }
        },
        "referenceAngle": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "stillAssets": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/stillAsset"
              }
            ]
          }
        },
        "stillReplacements": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/groupReplacement"
              }
            ]
          }
        },
        "programColorPolicy": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/programColorPolicy"
              }
            ]
          },
          "maxItems": 1
        },
        "assemblyItems": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/historyCopy"
              },
              {
                "$ref": "#/$defs/assemblyItem"
              }
            ]
          }
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "assembly",
          "assemblyItems"
        ]
      }
    },
    "multicamHistory": {
      "type": "object",
      "properties": {
        "undo": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/multicamStep"
          }
        },
        "redo": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/multicamStep"
          }
        }
      },
      "additionalProperties": false
    },
    "historyAction": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 1024
    },
    "historyCopy": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "sequenceItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "source": {
              "$ref": "#/$defs/clip"
            }
          },
          "required": [
            "kind",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "still"
            },
            "still": {
              "$ref": "#/$defs/stillInsert"
            }
          },
          "required": [
            "kind",
            "still"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assemblyItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "group"
            },
            "group": {
              "$ref": "#/$defs/range"
            }
          },
          "required": [
            "kind",
            "group"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "still"
            },
            "still": {
              "$ref": "#/$defs/stillInsert"
            }
          },
          "required": [
            "kind",
            "still"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stillAsset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "displayName": {
          "$ref": "#/$defs/id"
        },
        "fingerprint": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "file",
        "displayName",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "stillInsert": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "assetID": {
          "$ref": "#/$defs/id"
        },
        "duration": {
          "$ref": "#/$defs/time"
        },
        "cadence": {
          "$ref": "#/$defs/time"
        },
        "framing": {
          "$ref": "#/$defs/stillFraming"
        }
      },
      "required": [
        "id",
        "assetID",
        "duration",
        "cadence",
        "framing"
      ],
      "additionalProperties": false
    },
    "stillFraming": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "fit",
            "fill"
          ]
        },
        "crop": {
          "$ref": "#/$defs/stillCrop"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "mode",
        "background"
      ],
      "additionalProperties": false
    },
    "stillCrop": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/time"
        },
        "y": {
          "$ref": "#/$defs/time"
        },
        "width": {
          "$ref": "#/$defs/time"
        },
        "height": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "sequenceReplacement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "assetID": {
          "$ref": "#/$defs/id"
        },
        "framing": {
          "$ref": "#/$defs/stillFraming"
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stillFragment"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "assetID",
        "framing",
        "fragments"
      ],
      "additionalProperties": false
    },
    "groupReplacement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "assetID": {
          "$ref": "#/$defs/id"
        },
        "framing": {
          "$ref": "#/$defs/stillFraming"
        },
        "group": {
          "$ref": "#/$defs/range"
        }
      },
      "required": [
        "id",
        "assetID",
        "framing",
        "group"
      ],
      "additionalProperties": false
    },
    "stillFragment": {
      "type": "object",
      "properties": {
        "clipID": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      },
      "required": [
        "clipID",
        "range"
      ],
      "additionalProperties": false
    },
    "programColorPolicy": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "renditionPolicyVersion": {
          "const": 1
        },
        "diffuseWhiteNits": {
          "type": "integer",
          "minimum": 1
        },
        "transfer": {
          "$ref": "#/$defs/id"
        },
        "primaries": {
          "$ref": "#/$defs/id"
        },
        "matrix": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/id"
        },
        "viewingConditions": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "version",
        "renditionPolicyVersion",
        "diffuseWhiteNits",
        "transfer",
        "primaries",
        "matrix",
        "range",
        "viewingConditions"
      ],
      "additionalProperties": false
    },
    "stillFormat": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8192,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8192,
          "multipleOf": 2
        },
        "cadence": {
          "$ref": "#/$defs/time"
        },
        "codec": {
          "enum": [
            "h264",
            "hevc",
            "prores"
          ]
        },
        "container": {
          "enum": [
            "mov",
            "mp4"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "cadence",
        "codec",
        "container"
      ],
      "additionalProperties": false
    }
  }
}
